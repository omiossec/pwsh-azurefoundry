<?xml version="1.0" encoding="utf-8"?>
<!-- Default views for PwshAzureFoundry.* output types. Views are added with each cmdlet (phases 3-6). -->
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>PwshAzureFoundry.Connection</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.Connection</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>AccountName</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Endpoint</Label></TableColumnHeader>
                    <TableColumnHeader><Label>AuthMode</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Source</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>AccountName</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Endpoint</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>AuthMode</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Source</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <!-- Chat result: Content wraps so the answer stays readable in a console screenshot. -->
        <View>
            <Name>PwshAzureFoundry.ChatResult</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.ChatResult</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>FinishReason</Label><Width>12</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Tokens</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>Content</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <Wrap/>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>FinishReason</PropertyName></TableColumnItem>
                            <TableColumnItem><ScriptBlock>$_.Usage.TotalTokens</ScriptBlock></TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($null -ne $_.Content -and $_.Content -ne '') { $_.Content }
                                    elseif ($_.ToolCalls) { '[tool calls: ' + (@($_.ToolCalls.Name) -join ', ') + ']' }
                                </ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.ChatChunk</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.ChatChunk</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Index</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>FinishReason</Label><Width>12</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Content</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Index</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>FinishReason</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Content</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.ToolCall</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.ToolCall</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Id</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Name</Label></TableColumnHeader>
                    <TableColumnHeader><Label>ArgumentsJson</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>ArgumentsJson</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <!-- Classes: the view is selected by the .NET type name of the PowerShell class. -->
        <View>
            <Name>AzFoundryMessage</Name>
            <ViewSelectedBy>
                <TypeName>AzFoundryMessage</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Role</Label><Width>9</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Content</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <Wrap/>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Role</PropertyName></TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.ToolCalls) { '[tool calls: ' + (@($_.ToolCalls | ForEach-Object { if ($_.Name) { $_.Name } else { $_.function.name } }) -join ', ') + ']' }
                                    elseif ($_.ToolCallId) { '(' + $_.ToolCallId + ') ' + $_.Content }
                                    else { $_.Content }
                                </ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>AzFoundryTool</Name>
            <ViewSelectedBy>
                <TypeName>AzFoundryTool</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Name</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Description</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Arguments</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Description</PropertyName></TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($_.Parameters -and $_.Parameters['properties']) { @($_.Parameters['properties'].Keys) -join ', ' }</ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.Embedding</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.Embedding</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Index</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>Dimensions</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>Vector</Label><Width>36</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Text</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Index</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Dimensions</PropertyName></TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    $first = @($_.Vector | Select-Object -First 3 | ForEach-Object { $_.ToString('0.0000', [cultureinfo]::InvariantCulture) })
                                    '[' + ($first -join ', ') + $(if ($_.Vector.Length -gt 3) { ', ...' }) + ']'
                                </ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem><PropertyName>Text</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.DecisionAnswer</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.DecisionAnswer</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Question</Label><Width>16</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Type</Label><Width>6</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Answer</Label><Width>16</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Value</Label><Width>6</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>Confidence</Label><Width>10</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>Probabilities</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Question</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Answer</PropertyName></TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($null -ne $_.Value) { $_.Value.ToString('0.###', [cultureinfo]::InvariantCulture) }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>if ($null -ne $_.Confidence) { $_.Confidence.ToString('P1', [cultureinfo]::InvariantCulture) }</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>
                                    if ($_.Probabilities) {
                                        @(foreach ($key in $_.Probabilities.Keys) {
                                            '{0} {1}' -f $key, $_.Probabilities[$key].ToString('P0', [cultureinfo]::InvariantCulture)
                                        }) -join ', '
                                    }
                                </ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.Model</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.Model</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Format</Label><Width>10</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Name</Label><Width>24</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Version</Label><Width>10</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Status</Label><Width>18</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Tasks</Label><Width>20</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Skus</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Format</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>LifecycleStatus</PropertyName></TableColumnItem>
                            <TableColumnItem><ScriptBlock>@($_.Tasks) -join ', '</ScriptBlock></TableColumnItem>
                            <TableColumnItem><ScriptBlock>@($_.Skus) -join ', '</ScriptBlock></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.Deployment</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.Deployment</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Name</Label><Width>24</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Model</Label><Width>26</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Version</Label><Width>12</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Sku</Label><Width>16</Width></TableColumnHeader>
                    <TableColumnHeader><Label>Capacity</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
                    <TableColumnHeader><Label>State</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>ModelName</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Version</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Sku</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>Capacity</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>ProvisioningState</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PwshAzureFoundry.Endpoint</Name>
            <ViewSelectedBy>
                <TypeName>PwshAzureFoundry.Endpoint</TypeName>
            </ViewSelectedBy>
            <ListControl>
                <ListEntries>
                    <ListEntry>
                        <ListItems>
                            <ListItem><PropertyName>AccountName</PropertyName></ListItem>
                            <ListItem><PropertyName>ResourceGroupName</PropertyName></ListItem>
                            <ListItem><PropertyName>Location</PropertyName></ListItem>
                            <ListItem><PropertyName>Endpoint</PropertyName></ListItem>
                            <ListItem><PropertyName>OpenAIEndpoint</PropertyName></ListItem>
                            <ListItem><PropertyName>ChatCompletionsUri</PropertyName></ListItem>
                            <ListItem><PropertyName>EmbeddingsUri</PropertyName></ListItem>
                            <ListItem><PropertyName>DecisionUri</PropertyName></ListItem>
                            <ListItem><PropertyName>DisableLocalAuth</PropertyName></ListItem>
                            <ListItem>
                                <Label>Keys</Label>
                                <ScriptBlock>if ($_.PSObject.Properties['Key1']) { 'Key1, Key2 (SecureString)' } else { '(use -IncludeKey)' }</ScriptBlock>
                            </ListItem>
                        </ListItems>
                    </ListEntry>
                </ListEntries>
            </ListControl>
        </View>
    </ViewDefinitions>
</Configuration>
